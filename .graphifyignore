# graphify-specific ignore file (gitignore syntax).
# Falls back from .gitignore is NOT merged - this file replaces it for graphify's
# own scan, so repo build/venv excludes are carried over here too.

*~
*.swp
*.DS_Store
build
build-*
install
venv
.venv-sv-regress
.vscode
__pycache__
graphify-src-test
graphify-out
naja_sv_diagnostics.log
naja_perf.log
sv_constructor_perf.log
dump_if

# Large benchmark netlists duplicated in source and tutorial trees.
tinyrocket.v
src/najaeda/benchmarks/verilog/*
src/apps/naja_edit/examples/arm_core/src/arm_core.v
src/apps/naja_edit/examples/vexriscv/src/vexriscv.demo.GenFull.v

# Branding carries no implementation relationships.
docs/images/Naja-Logo.png

# Generated cell catalog and dependency release history add little architectural context.
primitives/asap7.py

# regress: fetched external content
regress

# thirdparty: only naja-if and naja-verilog are ours to analyze; everything
# else under thirdparty/ is vendored (cpptrace, googletest, lefdef, spdlog,
# yosys-liberty) and adds noise without adding signal to the graph.
thirdparty/*
!thirdparty/naja-if
!thirdparty/naja-verilog
!thirdparty/slang
!thirdparty/yosys-liberty

# Keep Slang itself, but omit its bundled dependencies.
thirdparty/slang/external/
thirdparty/slang/CHANGELOG.md
