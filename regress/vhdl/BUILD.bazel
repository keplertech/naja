load("@rules_shell//shell:sh_test.bzl", "sh_test")

sh_test(
    name = "soc_frontend_tests",
    srcs = ["run_soc_frontend.sh"],
    args = [
        "$(rootpath //src/nl/python/naja_wrapping:naja.so)",
        "$(rootpath //src/nl/python/naja_wrapping:naja_runtime)",
        "$(PYTHON3)",
        "$(rootpath :test_soc_frontend.py)",
    ],
    data = [
        "test_soc_frontend.py",
        "//src/nl/python/naja_wrapping:naja.so",
        "//src/nl/python/naja_wrapping:naja_runtime",
    ] + glob(["soc_probes/*.vhdl"]),
    toolchains = ["@rules_python//python:current_py_toolchain"],
)

sh_test(
    name = "memory_initialization_tests",
    srcs = ["run_soc_frontend.sh"],
    args = [
        "$(rootpath //src/nl/python/naja_wrapping:naja.so)",
        "$(rootpath //src/nl/python/naja_wrapping:naja_runtime)",
        "$(PYTHON3)",
        "$(rootpath :test_memory_initialization.py)",
    ],
    data = [
        "test_memory_initialization.py",
        "//src/nl/python/naja_wrapping:naja.so",
        "//src/nl/python/naja_wrapping:naja_runtime",
        "memory_file_init.vhdl",
    ],
    toolchains = ["@rules_python//python:current_py_toolchain"],
)
