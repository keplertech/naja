load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_shared_library.bzl", "cc_shared_library")

# Mirrors this directory's own CMakeLists.txt: builds `naja_python` (the
# raw CPython C-API binding sources) and `naja` (the actual importable
# extension module, a thin PyNaja.cpp wrapper around naja_python). See
# internal/bazel-migration-plan.md (Phase 6, task #21).
#
# CMake links naja_python against Python3::Module (this Bazel build's
# equivalent, @rules_python//python/cc:current_py_cc_headers -- no libpython linking, symbols resolve
# dynamically at import time) or Python3::Python (Python3::Embed
# equivalent, @rules_python//python/cc:current_py_cc_libs) depending on BUILD_NAJA_PYTHON. This
# target is the Module/extension-module case; naja_edit's embedded mode
# (task #22) needs its own copy linked against @rules_python//python/cc:current_py_cc_libs instead,
# since a single cc_library can't conditionally pick either at build
# time the way CMake's option toggle does.

cc_library(
    name = "naja_python",
    srcs = [
        "PySNLTimingAnalysis.cpp",
        "PyNetlistState.cpp",
        "PyNLID.cpp",
        "PyNLUniverse.cpp",
        "PyNLDB.cpp",
        "PyNLLibrary.cpp",
        "PyNLDBs.cpp",
        "PyNLLibraries.cpp",
        "PySNLDesign.cpp",
        "PySNLSequentialModel.cpp",
        "PySNLMemoryInterface.cpp",
        "PySNLAttribute.cpp",
        "PySNLParameter.cpp",
        "PyNLClock.cpp",
        "PyNLClocks.cpp",
        "PySNLDesignObject.cpp",
        "PySNLNet.cpp",
        "PySNLBusNet.cpp",
        "PySNLBitNet.cpp",
        "PySNLScalarNet.cpp",
        "PySNLBusNetBit.cpp",
        "PySNLNetType.cpp",
        "PySNLTermRole.cpp",
        "PySNLActiveLevel.cpp",
        "PySNLNetComponent.cpp",
        "PySNLTerm.cpp",
        "PySNLTermDirection.cpp",
        "PySNLBusTerm.cpp",
        "PySNLBundleTerm.cpp",
        "PySNLBitTerm.cpp",
        "PySNLScalarTerm.cpp",
        "PySNLBusTermBit.cpp",
        "PySNLInstance.cpp",
        "PySNLInstParameter.cpp",
        "PySNLInstTerm.cpp",
        "PySNLAttributes.cpp",
        "PySNLDesigns.cpp",
        "PySNLParameters.cpp",
        "PySNLInstParameters.cpp",
        "PySNLNetComponents.cpp",
        "PySNLTerms.cpp",
        "PySNLBitTerms.cpp",
        "PySNLScalarTerms.cpp",
        "PySNLBusTerms.cpp",
        "PySNLBundleTerms.cpp",
        "PySNLNets.cpp",
        "PySNLBitNets.cpp",
        "PySNLScalarNets.cpp",
        "PySNLBusNets.cpp",
        "PySNLInstances.cpp",
        "PySNLInstTerms.cpp",
        "PySNLPath.cpp",
        "PySNLOccurrence.cpp",
        "PySNLOccurrences.cpp",
        "PySNLEquipotential.cpp",
        "PySNLEquipotentialMode.cpp",
        "PyLogicCone.cpp",
        "PySNLUniquifier.cpp",
        "NajaPythonProperty.cpp",
    ],
    hdrs = glob(["*.h"]),
    defines = ["NAJA_PYTHON_EXPORTS"],
    includes = ["."],
    visibility = ["//visibility:public"],
    deps = [
        "//src/metrics:naja_metrics",
        "//src/tgraph:naja_tgraph",
        "//src/nl/formats/hdl:naja_snl_hdl",
        "//src/nl/formats/liberty:naja_snl_liberty",
        "//src/nl/formats/systemverilog:naja_snl_systemverilog",
        "//src/nl/formats/vhdl:naja_snl_vhdl",
        "//src/nl/formats/verilog:naja_snl_verilog",
        "//src/nl/netlist:naja_snl_visual",
        "//src/nl/netlist/serialization/capnp:naja_nl_dump",
        "//src/optimization:naja_opt",
        "@rules_python//python/cc:current_py_cc_headers",
    ],
)

cc_shared_library(
    name = "naja_runtime",
    deps = [
        ":naja_python",
        "//src/bne:naja_bne",
        "//src/core:naja_core",
        "//src/dnl:naja_dnl",
        "//src/metrics:naja_metrics",
        "//src/tgraph:naja_tgraph",
        "//src/nl/formats/hdl:naja_snl_hdl",
        "//src/nl/formats/liberty:naja_snl_liberty",
        "//src/nl/formats/systemverilog:naja_snl_systemverilog",
        "//src/nl/formats/vhdl:naja_snl_vhdl",
        "//src/nl/formats/verilog:naja_snl_verilog",
        "//src/nl/netlist:naja_nl",
        "//src/nl/netlist:naja_snl_visual",
        "//src/nl/netlist/serialization/capnp:naja_nl_dump",
        "//src/optimization:naja_opt",
    ],
    # The runtime links these statically and exports them, so that
    # binaries linking it (naja.so, kepler-formal) use its single copy
    # instead of linking their own. Package patterns rather than target
    # labels: zlib's BCR target behind @zlib//:z lives in a subpackage.
    exports_filter = [
        "//src:__subpackages__",
        "@fmt//:__subpackages__",
        "@onetbb//:__subpackages__",
        "@zlib//:__subpackages__",
    ],
    user_link_flags = select({
        "@platforms//os:macos": ["-undefined", "dynamic_lookup"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
)

cc_binary(
    name = "naja.so",
    srcs = ["PyNaja.cpp"],
    dynamic_deps = [":naja_runtime"],
    linkopts = select({
        # cc_binary's linkshared=True already implies -dynamiclib on
        # macOS (conflicts with -bundle, the traditional Python-extension
        # mach-o type) -- CPython's dlopen()-based import also accepts a
        # plain dylib on modern macOS, so only -undefined dynamic_lookup
        # (letting Python API symbols resolve at import time, since this
        # target links no libpython -- see @rules_python//python/cc:current_py_cc_headers) is needed.
        "@platforms//os:macos": ["-undefined", "dynamic_lookup"],
        "//conditions:default": [],
    }),
    linkshared = True,
    visibility = ["//visibility:public"],
    deps = [
        ":naja_python",
        "@rules_python//python/cc:current_py_cc_headers",
    ],
)
